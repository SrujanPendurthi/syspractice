# Docker on a Mac cannot reach the GPU, so the containerized Ollama runs on the CPU and
# critiques mostly time out. `cp .env.mac .env` uses Ollama on the host instead. Start it
# with a real context window or it truncates long prompts from the front:
#
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve
LLAMA_SERVER_URL=http://host.docker.internal:11434
SYSPRACTICE_RUNNER_REPLICAS=0
