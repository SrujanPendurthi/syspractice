#!/usr/bin/env bash
# Start everything: model runner (optional), backend, frontend. Ctrl-C stops all of them.
set -euo pipefail

# Job control, so each background job leads its own process group. `cargo run` and
# `npm run dev` both spawn the real server as a grandchild — killing only the direct
# child orphans it and leaves the port bound.
set -m

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

llama_port="${LLAMA_PORT:-8080}"
export LLAMA_SERVER_URL="http://127.0.0.1:${llama_port}"
export SYSPRACTICE_ADDR="${SYSPRACTICE_ADDR:-127.0.0.1:8787}"
# Pin the DB to the backend dir so it lands in the same place no matter where you run from.
export SYSPRACTICE_DB="${SYSPRACTICE_DB:-$root/backend/syspractice.db}"
# Safari refuses to store a Secure cookie from http://localhost, which would leave every
# sign-in here silently failing. Production leaves this unset and gets Secure cookies.
export SYSPRACTICE_SECURE_COOKIES="${SYSPRACTICE_SECURE_COOKIES:-0}"

pids=()

cleanup() {
  trap - EXIT INT TERM
  # Negative PID = whole process group, so grandchildren go too.
  for p in "${pids[@]:-}"; do
    [[ -n "$p" ]] && kill -TERM "-$p" 2>/dev/null || true
  done
  wait 2>/dev/null
  return 0
}
trap cleanup EXIT INT TERM

# --- model runner ------------------------------------------------------------
# Explicit LLAMA_MODEL picks llama.cpp; otherwise fall back to Ollama if it is installed.
# Both speak the same OpenAI-compatible API, they differ only in whether the request's
# "model" field is honoured (Ollama) or ignored (llama-server).
if [[ -n "${LLAMA_MODEL:-}" ]]; then
  if command -v llama-server >/dev/null 2>&1; then
    echo "==> llama-server on :${llama_port} ($(basename "$LLAMA_MODEL"))"
    llama-server -m "$LLAMA_MODEL" --port "$llama_port" </dev/null &
    pids+=($!)
    export SYSPRACTICE_MODEL="${SYSPRACTICE_MODEL:-local}"
  else
    echo "!!  LLAMA_MODEL is set but llama-server is not on PATH — critique will 502" >&2
  fi

elif command -v ollama >/dev/null 2>&1; then
  export LLAMA_SERVER_URL="http://127.0.0.1:11434"

  # Ollama defaults every model to a 4096-token context no matter what it was trained for,
  # and silently truncates the oldest tokens — which in a one-shot chat is the system prompt,
  # so an overflowing critique quietly stops following the four-section format. A reasoning
  # model spends most of its budget thinking: MiniCPM5-2B emitted ~2.3k tokens of reasoning
  # and content on a 5-node diagram. The OpenAI-compatible endpoint ignores options.num_ctx,
  # so this env var on the server is the only lever.
  export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-16384}"

  # Reasoning off: arithmetic is checked in code now, and MiniCPM5-2B's unbounded thinking
  # took minutes per critique. `SYSPRACTICE_REASONING_EFFORT= ./dev` turns it back on.
  export SYSPRACTICE_REASONING_EFFORT="${SYSPRACTICE_REASONING_EFFORT-none}"

  # Reuse an already-running daemon rather than starting a second one; only tear down
  # an instance this script owns.
  if ! curl -sf -m 2 "${LLAMA_SERVER_URL}/api/tags" >/dev/null 2>&1; then
    echo "==> starting ollama (context ${OLLAMA_CONTEXT_LENGTH})"
    ollama serve </dev/null >/dev/null 2>&1 &
    pids+=($!)
    for _ in $(seq 1 30); do
      curl -sf -m 1 "${LLAMA_SERVER_URL}/api/tags" >/dev/null 2>&1 && break
      sleep 1
    done
  else
    # A daemon we did not start keeps its own context setting; ours never reached it.
    echo "!!  reusing a running ollama — OLLAMA_CONTEXT_LENGTH=${OLLAMA_CONTEXT_LENGTH} not applied." >&2
    echo "    'ollama ps' shows the real context; restart the daemon to change it." >&2
  fi

  # Ollama resolves the model name, so a wrong one is a 404 at critique time.
  # `ollama list` is ordered by recency, so the first row is whatever was pulled last.
  # Pick deliberately instead. Measured on the url-shortener scenario: MiniCPM5-2B took
  # 1m38s and gemma4:12b 4m48s for a critique of comparable quality — the 2B misses the
  # back-of-the-envelope arithmetic, the 12b misses TTL/expiry. Fast default wins for a
  # draw-and-iterate loop; SYSPRACTICE_MODEL=gemma4:12b ./dev for a slower, sharper pass.
  if [[ -z "${SYSPRACTICE_MODEL:-}" ]]; then
    installed="$(ollama list 2>/dev/null | awk 'NR>1 {print $1}')"
    for want in hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M qwen3:8b gemma4:12b; do
      grep -qx "$want" <<<"$installed" && { SYSPRACTICE_MODEL="$want"; break; }
    done
    SYSPRACTICE_MODEL="${SYSPRACTICE_MODEL:-$(head -1 <<<"$installed")}"
    export SYSPRACTICE_MODEL
  fi

  if [[ -n "${SYSPRACTICE_MODEL:-}" ]]; then
    echo "==> ollama on :11434 (${SYSPRACTICE_MODEL})"
  else
    echo "!!  ollama has no models — run 'ollama pull qwen3:8b'. Critique will 502." >&2
  fi

else
  echo "!!  no model runner found; critique will 502. Install ollama, or:"
  echo "    LLAMA_MODEL=/path/to/model.gguf ./dev"
fi

# --- backend ----------------------------------------------------------------
echo "==> backend on http://${SYSPRACTICE_ADDR}"
cargo run --quiet --manifest-path "$root/backend/Cargo.toml" </dev/null &
pids+=($!)

# --- frontend ---------------------------------------------------------------
[[ -d "$root/frontend/node_modules" ]] || npm --prefix "$root/frontend" install

# Hold the frontend until the backend answers. On a cold cargo build this is a minute
# of compiling; starting vite first just means the first page load fails its API calls.
printf '==> waiting for backend'
for _ in $(seq 1 300); do
  curl -sf "http://${SYSPRACTICE_ADDR}/api/scenarios" >/dev/null 2>&1 && break
  printf '.'
  sleep 1
done
echo

echo "==> frontend on http://localhost:5173"
# stdin detached: with job control on, a child that reads stdin gets SIGTTIN and
# suspends. Costs vite's keyboard shortcuts, saves the dev server freezing.
npm --prefix "$root/frontend" run dev </dev/null &
pids+=($!)

# ponytail: macOS ships bash 3.2, which has no `wait -n`, so one child crashing leaves
# the others running rather than tearing everything down. Ctrl-C still cleans up all of
# them. Swap to `wait -n` if this ever runs under a guaranteed bash 4+.
wait
